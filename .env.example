# AWS Cloud Internship Portal - Environment Configuration Template
# Copy this file to .env for local overrides (never commit .env)

# AWS Settings
AWS_REGION=ap-south-1
S3_BUCKET_NAME=aws-internship-portal-madhumitha
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:internship-alerts-topic

# Application Settings
FLASK_DEBUG=False
PORT=5000
HOST=0.0.0.0
SECRET_KEY=replace-with-a-secure-random-string-in-production
